@page
@model DiscussionBoard.Pages.Amin.UsersModel

@{
    ViewData["Title"] = "Manage Users";
}
<h1>Manage Users</h1>

<form method="post">
    <div class="mb-3">
        <label asp-for="SelectUserId" class="form-label">
            Select User
        </label>

        <select asp-for="SelectUserId"
                asp-items="Model.UserOptions"
                class="form-select">
            <option value="">**Select User**</option>
        </select>

        <span asp-validation-for="SelectUserId"
              class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">
        Select User
    </button>
</form>

@if (Model.SelectUserId != null)

<hr />

<h2>Manage the User Role</h2>

<form method="post" asp-page-handler="UpdateRole">
    <input type="hidden"
           name="SelectUserId"
           value="@Model.SelectUserId" />

    <div class="mb-3">
        <strong>Display Name:</strong>
        @Model.SelectUser.DisplayName
    </div>

    <div class="mb-3">
        <strong>Email:</strong>
        @Model.SelectUser.Email
    </div>
    @if (Model.IsSelectedUserAdmin)
    {
        <button type="submit" class="btn btn-danger">
            Remove Admin Role
        </button>
    }
    else
    {
    <button type="submit" class="btn btn-primary">
        Update Admin Role
    </button>
    }
</form>
