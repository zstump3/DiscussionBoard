@using DiscussionBoard.Services
@model DiscussionBoard.Models.DiscussionThread

@{
    var displayName = String.IsNullOrWhiteSpace(Model.ApplicationUser?.DisplayName)
        ? "Unconfigured User" : Model.ApplicationUser.DisplayName;

    var avatarId = Model.ApplicationUser?.AvatarId ?? "default";

    if (!AvatarCatalog.IsValid(avatarId))
    {
        avatarId = "default";
    }
}

<article class="card mb-3">
    <div class="card-body">
        <h2 class="h5">
            <a asp-page="/Discussions/Details"
               asp-route-threadId="@Model.Id">
                @Model.Title
            </a>
        </h2>

        <div class="d-flex align-items-center gap-2 mb-2">
            <img src="@AvatarCatalog.ImagePath(avatarId)"
                 class="rounded-circle img-fluid"
                 alt="User Profile"
                 style="width: 25px; height: 25px; object-fit: cover;" />

            <span>@displayName</span>
        </div>

        <p>@Model.Content</p>
    </div>
</article>
