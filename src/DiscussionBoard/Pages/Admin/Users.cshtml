@page
@model DiscussionBoard.Pages.Admin.UsersModel

@{
    ViewData["Title"] = "Manage Users";
}
<h1>Manage Users</h1>
@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-info" role="alert">
        @Model.StatusMessage
    </div>
}

<form method="post">
    <div class="mb-3">
        <label asp-for="SelectedUserId" class="form-label">
            Select User
        </label>

        <select asp-for="SelectedUserId"
                asp-items="Model.UserOptions"
                class="form-select">
            <option value="">**Select User**</option>
        </select>

        <span asp-validation-for="SelectedUserId"
              class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">
        Select User
    </button>
</form>

@if (Model.SelectUser != null)
{
    <hr/>

    <h2>Manage the User Role</h2>

    <form method="post" asp-page-handler="UpdateRole">
        <input type="hidden"
               name="SelectUserId"
               value="@Model.SelectUser.Id"/>

        <div class="mb-3">
            <strong>Display Name:</strong>
            @Model.SelectUser.DisplayName
        </div>

        <div class="mb-3">
            <strong>Email:</strong>
            @Model.SelectUser.Email
        </div>
        @if (Model.IsSelectedUserAdmin)
        {
            <button type="submit"
                    name="RoleAction"
                    value="Remove"
                    class="btn btn-danger">
                Remove Admin Role
            </button>
        }
        else
        {
            <button type="submit"
                    name="RoleAction"
                    value="Add"
                    class="btn btn-success">
                Add Admin Role
            </button>
        }
    </form>
}
