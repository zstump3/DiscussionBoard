@page "{id:int}"
@model DiscussionBoard.Pages.Discussions.EditModel

<h1>Edit Discussion</h1>

<form method="post">
    <div asp-validation-summary="All"
         class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Input.Title"
               class="form-label"></label>

        <input asp-for="Input.Title"
               class="form-control" />

        <span asp-validation-for="Input.Title"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Content"
               class="form-label"></label>

        <textarea asp-for="Input.Content"
                  class="form-control"></textarea>

        <span asp-validation-for="Input.Content"
              class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">
        Save Changes
    </button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
