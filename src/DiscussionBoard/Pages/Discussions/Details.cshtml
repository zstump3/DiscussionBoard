@page "/Discussion/{threadId}"
@using DiscussionBoard.Services
@model DiscussionBoard.Pages.Discussions.DetailsModel

@{
    ViewData["Title"] = Model.Discussion.Title;

    var displayName = string.IsNullOrWhiteSpace(Model.Discussion.ApplicationUser?.DisplayName)
        ? "Unconfigured User"
        : Model.Discussion.ApplicationUser.DisplayName;

    var avatarId = Model.Discussion.ApplicationUser?.AvatarId ?? "default";

    if (!AvatarCatalog.IsValid(avatarId))
    {
        avatarId = "default";
    }
}

<h1>@Model.Discussion.Title</h1>

<div class="d-flex align-items-center gap-2 mb-2">
    <img src="@AvatarCatalog.ImagePath(avatarId)"
         class="rounded-circle img-fluid"
         alt="User Profile"
         style="width: 25px; height: 25px; object-fit: cover;" />

    <span>@displayName</span>
</div>

<p>@Model.Discussion.Content</p>

<hr />

<h2>Replies</h2>

@foreach (var post in Model.Posts)
{
    <partial name="/Pages/Discussions/_PostTree.cshtml"
             model="post" />
}

    <h3>Reply to Discussion</h3>

    <form method="post"
          asp-page-handler="Reply"
          asp-route-threadId="@Model.Discussion.Id">

        <div asp-validation-summary="All"
             class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="Input.Content"
                   class="form-label"></label>

            <textarea asp-for="Input.Content"
                      class="form-control"></textarea>

            <span asp-validation-for="Input.Content"
                  class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">
            Post Reply
        </button>
    </form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
